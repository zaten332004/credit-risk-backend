API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Google Sign-In (GIS): Web client ID — phải trùng GOOGLE_OAUTH_CLIENT_ID trên backend (.env).
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# Đăng xuất khi không tương tác (phút). JWT backend nên đủ dài; idle được xử lý ở client.
NEXT_PUBLIC_SESSION_IDLE_MINUTES=30
