PROJECT_NAME=Credit Risk Analysis Dashboard & Chatbot System
# Tắt log từng request kiểu: INFO: ... "GET /api/v1/... HTTP/1.1" (uvicorn.access). Bật lại khi cần: UVICORN_ACCESS_LOG=1
# UVICORN_ACCESS_LOG=1

API_V1_PREFIX=/api/v1
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_PUBLIC_BASE_URL=http://localhost:8000

EMAIL_BACKEND=console
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@creditrisk.com

MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Web client ID (GIS). Trùng với NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID trên frontend; Google Console: Authorized JavaScript origins = origin app (vd http://localhost:3000).
GOOGLE_OAUTH_CLIENT_ID=107362476626-9mfhmqrbnn6ldat5pora0ja9mvebr1ro.apps.googleusercontent.com

SECRET_KEY=replace-with-a-long-random-secret
# JWT (phút). Mặc định 7 ngày; hết phiên theo “không tương tác” do frontend quản lý.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Local: dùng mysql+pymysql://...  |  Railway thường cho mysql://... — backend tự đổi sang +pymysql.
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/creditriskdb?charset=utf8mb4

# Optional: absolute path for CSV/upload job temp files. Retention: hours (0 = never auto-delete by age).
# Sweeper interval (minutes): removes expired + invalid/orphan files (meta without data, data without meta). 0 = only sweep once at startup.
# UPLOAD_JOBS_STORAGE_DIR=
# UPLOAD_JOBS_RETENTION_HOURS=168
# UPLOAD_JOBS_CLEANUP_INTERVAL_MINUTES=60

# Audit_Log: auto-delete rows older than N days (performed_at, UTC). 0 = never delete.
# AUDIT_LOG_RETENTION_DAYS=7
# AUDIT_LOG_CLEANUP_INTERVAL_MINUTES=60

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_CHAT_PROVIDER=gemini
AI_CHAT_CONTEXT_SOURCE=powerbi

BANK_FAQ_CSV_PATH=
BANK_FAQ_TOP_K=3

POWER_BI_TENANT_ID=
POWER_BI_CLIENT_ID=
POWER_BI_CLIENT_SECRET=
POWER_BI_WORKSPACE_ID=
POWER_BI_DATASET_ID=
# AI chat context: departmental tables (match your Power BI model names; loan-style CSV → CustomerMaster, LoanPortfolio, CollateralRegister)
POWER_BI_AI_CONTEXT_TABLE=LoanPortfolio
POWER_BI_AI_CONTEXT_TABLES=CustomerMaster,LoanPortfolio,CollateralRegister
POWER_BI_AI_CONTEXT_MAX_ROWS=200
POWER_BI_AI_CONTEXT_DAX=
POWER_BI_AI_CONTEXT_MAX_CHARS=4000
POWER_BI_AI_CONTEXT_REQUIRED_KEYS=
POWER_BI_AI_CONTEXT_MODE=all_tables
POWER_BI_AI_CONTEXT_MAX_TABLES=12
POWER_BI_AI_CONTEXT_MAX_COLUMNS=8
AI_CHAT_POWERBI_QUERY_ALLOW_ANY=0

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
